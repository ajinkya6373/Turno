{
  "info": {
    "name": "Turno Vehicle Store API",
    "_postman_id": "turno-vehicle-store-api",
    "description": "Complete API collection for the Turno Multi-Brand Vehicle Store backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Paste your JWT token here after login"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Paste admin JWT token here after admin login"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"pass123\"\n}"
            }
          }
        },
        {
          "name": "Login (User)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"user123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@turno.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get all vehicles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles"
          }
        },
        {
          "name": "Filter by brand",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?brand=Tesla",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [{ "key": "brand", "value": "Tesla" }]
            }
          }
        },
        {
          "name": "Filter by fuel type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?fuelType=Electric",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [{ "key": "fuelType", "value": "Electric" }]
            }
          }
        },
        {
          "name": "Filter by price range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?minPrice=20000&maxPrice=45000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "minPrice", "value": "20000" },
                { "key": "maxPrice", "value": "45000" }
              ]
            }
          }
        },
        {
          "name": "Filter by brand + fuel type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?brand=Toyota&fuelType=Diesel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "brand", "value": "Toyota" },
                { "key": "fuelType", "value": "Diesel" }
              ]
            }
          }
        },
        {
          "name": "Get vehicle summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles/summary"
          }
        },
        {
          "name": "Get vehicle by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles/1"
          }
        },
        {
          "name": "Add vehicle (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"BMW\",\n  \"name\": \"X5 xDrive40i\",\n  \"price\": 72000,\n  \"fuelType\": \"Petrol\",\n  \"description\": \"Luxury mid-size SUV with M Sport package\",\n  \"imageUrl\": \"https://example.com/bmw-x5.jpg\"\n}"
            }
          }
        },
        {
          "name": "Add vehicle — missing required field (should fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"BMW\",\n  \"name\": \"X5\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Bookmarks",
      "item": [
        {
          "name": "Get my bookmarks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookmarks"
          }
        },
        {
          "name": "Add bookmark",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookmarks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 7\n}"
            }
          }
        },
        {
          "name": "Add duplicate bookmark (should fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookmarks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 7\n}"
            }
          }
        },
        {
          "name": "Remove bookmark",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookmarks/1"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"customerName\": \"John Doe\",\n  \"customerEmail\": \"john@example.com\",\n  \"bookingDate\": \"2026-06-15\"\n}"
            }
          }
        },
        {
          "name": "Create booking — invalid date (should fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"customerName\": \"John Doe\",\n  \"customerEmail\": \"john@example.com\",\n  \"bookingDate\": \"not-a-date\"\n}"
            }
          }
        },
        {
          "name": "Get my bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/bookings"
          }
        }
      ]
    }
  ]
}
