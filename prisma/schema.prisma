generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())

  bookmarks Bookmark[]
  bookings  Booking[]
}

enum Role {
  USER
  ADMIN
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  brand       String
  name        String
  price       Float
  fuelType    FuelType
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  bookmarks Bookmark[]
  bookings  Booking[]

  @@index([brand])
  @@index([fuelType])
  @@index([price])
}

enum FuelType {
  Petrol
  Diesel
  Electric
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  vehicleId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  vehicleId     Int
  customerName  String
  customerEmail String
  bookingDate   DateTime
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
